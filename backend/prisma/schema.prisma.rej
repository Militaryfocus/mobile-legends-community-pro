--- schema.prisma
+++ schema.prisma
@@ -92,9 +92,11 @@ model Post {
   media      Media[]
   tags       PostTag[]
 
-  @@index([authorId])
-  @@index([type])
-  @@index([createdAt])
+  @@index([authorId, status, createdAt])
